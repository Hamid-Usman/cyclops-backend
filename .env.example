# MySQL connection. Migrations run automatically on start.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/cyclops

# Random secret of at least 32 characters for signing access tokens.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

PORT=3000

# Browser frontends allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3001

# Optional. Without it the app uses an in-memory cache.
REDIS_URL=redis://localhost:6379

# Optional. Google OAuth client id(s), comma-separated. Without it the Google
# sign-in endpoints answer 503.
GOOGLE_CLIENT_ID=

# Optional. NestJS Observe key pair, written by `npx @nestjs/observe link`.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Optional. MySQL connections kept in the pool (default 10). Keep it below
# your database plan's connection limit.
DB_POOL_SIZE=10
